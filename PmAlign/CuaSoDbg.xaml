<Window x:Class="A38.ImageCrop.PmAlign.CuaSoDbg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug — tung buoc bien doi"
        Height="820" Width="1180" WindowStartupLocation="CenterOwner"
        Background="#FF2B2B2B" Foreground="#FFE8E8E8" FontFamily="Segoe UI" FontSize="12">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="MinWidth" Value="86"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- ================= THANH DIEU KHIEN ================= -->
    <Border DockPanel.Dock="Top" Background="#FF3C3F41" Padding="8,6"
            BorderBrush="#FF1E1E1E" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="CbDung" Content="Dung tung buoc"
                  Checked="CbDung_Doi" Unchecked="CbDung_Doi"/>
        <Button x:Name="NutTiep"      Content="Tiep ▶"     Click="Tiep_Click"      IsEnabled="False"
                Background="#FF1565C0" Foreground="White"/>
        <Button x:Name="NutChayThang" Content="Chay thang" Click="ChayThang_Click" IsEnabled="False"/>
        <Border Width="1" Background="#FF5A5A5A" Margin="6,2"/>
        <CheckBox x:Name="CbGhiPng" Content="Ghi PNG ra debug_out"
                  Checked="CbGhiPng_Doi" Unchecked="CbGhiPng_Doi"
                  ToolTip="Tat mac dinh: ma hoa PNG moi buoc la thu lam mot lan Run mat 26 giay."/>
        <CheckBox x:Name="CbVuaKhung" Content="Vua khung" IsChecked="True"
                  Checked="CbVuaKhung_Doi" Unchecked="CbVuaKhung_Doi"/>
        <Button Content="Xoa" Click="Xoa_Click" MinWidth="56"/>
        <Border Width="1" Background="#FF5A5A5A" Margin="6,2"/>
        <TextBlock x:Name="TtTrangThai" Text="San sang." FontFamily="Consolas"/>
      </StackPanel>
    </Border>

    <!-- ================= NHAT KY ================= -->
    <Border DockPanel.Dock="Bottom" Background="#FF313335" BorderBrush="#FF1E1E1E" BorderThickness="0,1,0,0">
      <TextBox x:Name="Nhat" Height="130" Background="#FF3C3F41" Foreground="#FFE8E8E8"
               BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
               TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Border>

    <!-- ================= DANH SACH BUOC ================= -->
    <Border DockPanel.Dock="Left" Width="290" Background="#FF313335"
            BorderBrush="#FF1E1E1E" BorderThickness="0,0,1,0">
      <ListBox x:Name="DsBuoc" Background="Transparent" Foreground="#FFE8E8E8"
               BorderThickness="0" FontFamily="Consolas" FontSize="11"
               SelectionChanged="DsBuoc_SelectionChanged"/>
    </Border>

    <!-- ================= ANH ================= -->
    <ScrollViewer x:Name="Khung" Background="#FF1B1B1B"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Image x:Name="AnhXem" Stretch="Uniform" StretchDirection="DownOnly"
             RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </ScrollViewer>

  </DockPanel>
</Window>
