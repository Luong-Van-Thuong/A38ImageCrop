<Window x:Class="A38.ImageCrop.PmAlign.CuaSoPmAlign"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PmAlign — do mau theo hinh dang (kieu CogPMAlign)"
        Height="900" Width="1480" WindowStartupLocation="CenterScreen"
        Background="#FF2B2B2B" Foreground="#FFE8E8E8" FontFamily="Segoe UI" FontSize="12">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="Padding" Value="0,2,0,2"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="Margin" Value="0,3,0,3"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="Margin" Value="6,0,6,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="MinWidth" Value="72"/>
    </Style>
    <Style x:Key="O" TargetType="TextBox">
      <Setter Property="Background" Value="#FF3C3F41"/>
      <Setter Property="Foreground" Value="#FFE8E8E8"/>
      <Setter Property="BorderBrush" Value="#FF5A5A5A"/>
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="Margin" Value="0,1,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>
    <Style x:Key="Nhom" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF8FD1FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <!-- ================= THANH CONG CU ================= -->
    <Border DockPanel.Dock="Top" Background="#FF3C3F41" Padding="8,6" BorderBrush="#FF1E1E1E" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="NutMoAnh"    Content="Mo anh…"  Click="MoAnh_Click"/>
        <Border Width="1" Background="#FF5A5A5A" Margin="6,2"/>
        <Button x:Name="NutTrain"    Content="Train"    Click="Train_Click"    Background="#FF2E7D32" Foreground="White"/>
        <Button x:Name="NutTrainNhieu" Content="Train nhieu anh…" Click="TrainNhieu_Click" Background="#FF1B5E20" Foreground="White"
                ToolTip="Train tren anh dang mo, roi bat model tu chung minh tren nhung anh khac va LOAI nhung diem khong tru duoc.&#10;Dung khi mot nua so diem model roi vao phan noi that doi theo goc nghieng / phan quang."/>
        <Button x:Name="NutRun"      Content="Run"      Click="Run_Click"      Background="#FF1565C0" Foreground="White"/>
        <Button x:Name="NutXemModel" Content="Xem model" Click="XemModel_Click"/>
        <CheckBox x:Name="CbDebug" Content="Debug" Margin="8,0,4,0" VerticalAlignment="Center"
                  Checked="CbDebug_Doi" Unchecked="CbDebug_Doi"
                  ToolTip="Hien tung buoc bien doi anh trong cua so Debug (khong dung ImShow, khong ghi PNG)."/>
        <Border Width="1" Background="#FF5A5A5A" Margin="6,2"/>
        <Button x:Name="NutLuuModel" Content="Luu model" Click="LuuModel_Click"/>
        <Button x:Name="NutNapModel" Content="Nap model" Click="NapModel_Click"/>
        <Border Width="1" Background="#FF5A5A5A" Margin="6,2"/>

        <TextBlock Text="Dang khoanh:" Margin="4,0,4,0"/>
        <RadioButton x:Name="RdTim"  Content="Vung tim kiem" IsChecked="True" Checked="DoiChe"/>
        <RadioButton x:Name="RdRoi"  Content="ROI mau"                        Checked="DoiChe"/>
        <RadioButton x:Name="RdMask" Content="Vung che"                       Checked="DoiChe"/>
        <Button x:Name="NutXoaMask" Content="Xoa che" Click="XoaMask_Click" Margin="6,0,4,0"/>

        <Border Width="1" Background="#FF5A5A5A" Margin="6,2"/>
        <TextBlock Text="Goc ROI:" Margin="4,0,4,0"/>
        <TextBox x:Name="ONhapGoc" Style="{StaticResource O}" Width="62" KeyDown="ONhapGoc_KeyDown"/>
        <TextBlock Text="°" Margin="2,0,4,0"/>
        <Slider x:Name="ThanhGoc" Minimum="0" Maximum="360" Width="220" VerticalAlignment="Center"
                ValueChanged="ThanhGoc_ValueChanged"/>
        <Button Content="0°"  Click="GocNhanh_Click" Tag="0"   MinWidth="34"/>
        <Button Content="90°" Click="GocNhanh_Click" Tag="90"  MinWidth="40"/>
        <Button Content="180°" Click="GocNhanh_Click" Tag="180" MinWidth="44"/>
        <Button Content="270°" Click="GocNhanh_Click" Tag="270" MinWidth="44"/>
      </StackPanel>
    </Border>

    <!-- ================= THANH TRANG THAI ================= -->
    <Border DockPanel.Dock="Bottom" Background="#FF3C3F41" Padding="8,4" BorderBrush="#FF1E1E1E" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TtToaDo" Grid.Column="0" Text="—" MinWidth="260" FontFamily="Consolas"/>
        <TextBlock x:Name="TtThongTin" Grid.Column="1" Text="Chua mo anh." Margin="16,0,0,0"/>
        <TextBlock x:Name="TtZoom" Grid.Column="2" Text="100%" FontFamily="Consolas"/>
      </Grid>
    </Border>

    <!-- ================= BANG THAM SO ================= -->
    <Border DockPanel.Dock="Right" Width="330" Background="#FF313335" BorderBrush="#FF1E1E1E" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,12,10">
        <StackPanel>

          <TextBlock Style="{StaticResource Nhom}" Text="THAM SO TRAIN"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="So muc kim tu thap"/>      <TextBox Grid.Row="0" Grid.Column="1" x:Name="TSoMuc"     Style="{StaticResource O}"/>
            <TextBlock Grid.Row="1" Text="Kernel lam mo (le)"/>      <TextBox Grid.Row="1" Grid.Column="1" x:Name="TBlur"      Style="{StaticResource O}"/>
            <TextBlock Grid.Row="2" Text="He so mat do bien"/>       <TextBox Grid.Row="2" Grid.Column="1" x:Name="THeSoBien"  Style="{StaticResource O}"/>
            <TextBlock Grid.Row="3" Text="Khoang cach diem (px)"/>   <TextBox Grid.Row="3" Grid.Column="1" x:Name="TKcDiem"    Style="{StaticResource O}"/>
            <TextBlock Grid.Row="4" Text="So diem toi da / muc"/>    <TextBox Grid.Row="4" Grid.Column="1" x:Name="TSoDiem"    Style="{StaticResource O}"/>
            <TextBlock Grid.Row="5" Text="Nguong bien toi thieu"/>   <TextBox Grid.Row="5" Grid.Column="1" x:Name="TBienMin"   Style="{StaticResource O}"/>
          </Grid>

          <TextBlock Style="{StaticResource Nhom}" Text="MAT NA TU DONG (tuy du an — luon soi bang Debug)"/>
          <TextBlock Text="Mat na THAN (duoc lay diem)" Margin="0,2,0,0"/>
          <ComboBox x:Name="CbThan" SelectedIndex="0" ToolTip="Khong = lay ca ROI. Chon kieu theo do tuong phan vat/nen cua du an.">
            <ComboBoxItem Content="Khong (an toan, mac dinh)"/>
            <ComboBoxItem Content="Vat TOI tren nen SANG"/>
            <ComboBoxItem Content="Vat SANG tren nen TOI"/>
            <ComboBoxItem Content="Toi/nen sang, min 3 kenh (1240S)"/>
          </ComboBox>
          <CheckBox x:Name="CbBaoLoi" Content="Bao loi mat na than" Margin="0,4,0,0"
                    ToolTip="Tat khi vat hinh C / khung rong: bao loi se nuot ca phan rong."/>

          <TextBlock Text="Mat na CHE (don-care)" Margin="0,6,0,0"/>
          <ComboBox x:Name="CbDong" SelectedIndex="0" ToolTip="Ngoai lua chon nay, cac hinh ve tay LUON duoc dung lam don-care.">
            <ComboBoxItem Content="Khong (chi hinh ve tay)"/>
            <ComboBoxItem Content="Vung am do/vang: R − B &gt; nguong"/>
          </ComboBox>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Nguong che (R − B)"/>      <TextBox Grid.Row="0" Grid.Column="1" x:Name="TDongRB"  Style="{StaticResource O}"/>
            <TextBlock Grid.Row="1" Text="Mo vung che (px)"/>        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TMoDong"  Style="{StaticResource O}"/>
            <TextBlock Grid.Row="2" Text="Noi rong vung che (px)"/>  <TextBox Grid.Row="2" Grid.Column="1" x:Name="TNoiChe"  Style="{StaticResource O}"/>
            <TextBlock Grid.Row="3" Text="Noi rong than (px)"/>      <TextBox Grid.Row="3" Grid.Column="1" x:Name="TNoiThan" Style="{StaticResource O}"/>
            <TextBlock Grid.Row="4" Text="Noi khung mat na (ti le)"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="TNoiKhung" Style="{StaticResource O}"/>
            <TextBlock Grid.Row="5" Text="Than toi thieu (ti le)"/>  <TextBox Grid.Row="5" Grid.Column="1" x:Name="TThanMin" Style="{StaticResource O}"/>
          </Grid>

          <TextBlock Style="{StaticResource Nhom}" Text="THAM SO RUN"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Goc quet tu (°)"/>         <TextBox Grid.Row="0" Grid.Column="1" x:Name="TGocTu"    Style="{StaticResource O}"/>
            <TextBlock Grid.Row="1" Text="Goc quet den (°)"/>        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TGocDen"   Style="{StaticResource O}"/>
            <TextBlock Grid.Row="2" Text="So ung vien dinh"/>        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TUngVien"  Style="{StaticResource O}"/>
            <TextBlock Grid.Row="3" Text="Diem toi thieu (0..1)"/>   <TextBox Grid.Row="3" Grid.Column="1" x:Name="TDiemMin"  Style="{StaticResource O}"/>
            <TextBlock Grid.Row="4" Text="So ket qua"/>              <TextBox Grid.Row="4" Grid.Column="1" x:Name="TSoKq"     Style="{StaticResource O}"/>
            <TextBlock Grid.Row="5" Text="He so san gradient"
                       ToolTip="Nhan vao nguong Canny ma muc do da dung luc train. 1.0 = chay dung nhu luc train; ha xuong khi lo hang toi/nhoe hon anh mau."/>
            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="THeSoSan" Style="{StaticResource O}"/>
          </Grid>
          <CheckBox x:Name="CbNoiSuy" Content="Noi suy duoi pixel / duoi buoc goc" IsChecked="True"/>

          <TextBlock Style="{StaticResource Nhom}" Text="CHAM DIEM"/>
          <CheckBox x:Name="CbNms" Content="NMS luc chay (bien manh 1px)" IsChecked="True"
                    ToolTip="Dung Canny luc chay thay cho san do lon tran trui, dung cap nguong ma muc do da dung luc train.&#10;Train dung Canny ma Run chi dung san la hai dinh nghia 'bien' khac nhau — do la loi goc lam tool bat vao vung texture.&#10;PHAI di kem 'Dung sai' > 0 va PHAI de 'Bo chieu tuong phan' TAT: bat rieng NMS thi top-1 tut tu 31/34 xuong 24/34."/>
          <CheckBox x:Name="CbBoDau" Content="Bo chieu tuong phan (|cos|)" IsChecked="False"
                    ToolTip="TAT = tich vo huong CO DAU (mac dinh, giong IgnorePolarity=false cua Cognex).&#10;Bat len chi khi tuong phan that su DAO giua cac lo hang.&#10;Bo dau la khong phan biet duoc GO (vet xuoc, hai mep nguoc dau) voi BAC (canh vat, mot dau)."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Dung sai ghep bien (px)"
                       ToolTip="Diem model duoc ghep voi bien GAN NHAT trong ban kinh nay, trong so giam tuyen tinh theo khoang cach.&#10;Tinh bang pixel CUA MUC dang xet, nen o muc tho no tu noi rong ra.&#10;Do duoc: 1, 2, 3 px deu cho top-1 34/34; 1 px cho bien rong nhat, 3 px cho thang diem cao nhat. 0 = tat."/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TDungSai" Style="{StaticResource O}"/>
            <TextBlock Grid.Row="1" Text="He so tru clutter"
                       ToolTip="Diem xep hang = Diem − he so × Clutter. Clutter = ti le pixel bien trong dau chan model ma model KHONG giai thich duoc.&#10;Mac dinh 0: tren bo JeaYoung/Coil clutter cua tu the dung (0.70) va sai (0.79) chong lan qua nhieu nen khong doi duoc tam nao."/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="THeSoClutter" Style="{StaticResource O}"/>
            <TextBlock Grid.Row="2" Text="Clutter toi da (1 = tat)"/>
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TClutterMax" Style="{StaticResource O}"/>
          </Grid>
          <CheckBox x:Name="CbDoClutter" Content="Luon do va bao clutter" IsChecked="True"/>
          <CheckBox x:Name="CbVeDiem" Content="Ve diem model len ket qua" IsChecked="True" Checked="VeLai_Click" Unchecked="VeLai_Click"/>

          <TextBlock Style="{StaticResource Nhom}" Text="KET QUA"/>
          <ListBox x:Name="DsKetQua" Height="110" Background="#FF3C3F41" Foreground="#FFE8E8E8"
                   BorderBrush="#FF5A5A5A" FontFamily="Consolas" FontSize="11"/>

          <TextBlock Style="{StaticResource Nhom}" Text="NHAT KY"/>
          <TextBox x:Name="Nhat" Height="200" Style="{StaticResource O}" IsReadOnly="True"
                   HorizontalContentAlignment="Left" FontFamily="Consolas" FontSize="11"
                   TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ================= KHUNG XEM ANH ================= -->
    <Border x:Name="Vung" Background="#FF1B1B1B" ClipToBounds="True"
            MouseDown="Vung_MouseDown" MouseUp="Vung_MouseUp"
            MouseMove="Vung_MouseMove" MouseWheel="Vung_MouseWheel"
            SizeChanged="Vung_SizeChanged" Focusable="True">
      <Canvas x:Name="Toan" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Image x:Name="AnhXem" Canvas.Left="0" Canvas.Top="0"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Canvas>
    </Border>

  </DockPanel>
</Window>
